# Todo-List Backend - Environment Variables
# Copy this file to .env and adjust values as needed

# Storage backend type: 'json' (default) or 'sheets'
STORAGE_BACKEND=json

# JSON storage file path (used when STORAGE_BACKEND=json)
STORAGE_PATH=/tmp/todos.json

# Google Sheets Backend Configuration (used when STORAGE_BACKEND=sheets)
# One of these must be set for sheets backend:
# SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# SERVICE_ACCOUNT_CREDENTIALS='{...json credentials...}'
# OAUTH_CREDENTIALS='{...oauth credentials...}'

# Spreadsheet ID for Google Sheets backend
# SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet name (worksheet name within the spreadsheet)
# SHEET_NAME=Todos
# Environment configuration for todo-list

# Application port (host port mapping)
APP_PORT=5000

# Backend type: 'json' (default) or 'sheets' (Google Sheets)
BACKEND_TYPE=json

# JSON backend storage path (inside container)
STORAGE_PATH=/app/data/todos.json

# Gunicorn workers
WORKERS=2

# Google Sheets backend (only when BACKEND_TYPE=sheets)
# SERVICE_ACCOUNT_FILE=/app/config/service-account.json
# SPREADSHEET_ID=your-spreadsheet-id
# SHEET_NAME=Todos
